# Einstellungen des Content-Hub-Servers.
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die Datei ".env" enthält Geheimnisse und gehört nicht ins Repository.

# Port und öffentliche Adresse des Servers (HTTPS, ohne Schrägstrich am Ende).
PORT=8080
PUBLIC_BASE_URL=https://content-hub.example.com

# PostgreSQL-Datenbank.
DATABASE_URL=postgresql://contenthub:PASSWORT@localhost:5432/contenthub?sslmode=disable

# Schlüssel für die Verschlüsselung der Instagram-Tokens (32 Byte, Base64).
# Erzeugen mit:  openssl rand -base64 32
# Gut aufbewahren: Geht er verloren, müssen alle Accounts neu verbunden werden.
TOKEN_ENCRYPTION_KEY=

# Meta-App "Instagram API mit Instagram Login" (developers.facebook.com).
# Als Redirect-URL in der Meta-App eintragen: <PUBLIC_BASE_URL>/api/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta-App "Instagram API mit Facebook Login" (für Hashtags und Wettbewerber).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Graph-API-Version.
GRAPH_API_VERSION=v25.0

# KI-Zugang für Umsetzungsvorschläge (Claude API, console.anthropic.com).
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Wohin der Server nach dem Instagram-Login zurückspringt.
# Web-App: leer lassen (Standard ist <PUBLIC_BASE_URL>/oauth-fertig).
# iOS-App später: contenthub://oauth
APP_CALLBACK_URL=

# Ordner für hochgeladene Medien und Ordner mit der gebauten Web-App.
STORAGE_DIR=storage
WEB_DIR=../app/build/web

# Hintergrundjobs (Sync, geplantes Veröffentlichen, RSS). Normalerweise true.
ENABLE_SCHEDULER=true
